# Gemini API Key (get from https://aistudio.google.com/u/0/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Configuration
JWT_SECRET=super_secret_random_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Database
DATABASE_PATH=sqlite:///./support_system.db

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
